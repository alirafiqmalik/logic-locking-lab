INPUT(tx_fifo_rp_0)
INPUT(tx_fifo_wp_0)
INPUT(tx_fifo_wp_1)
INPUT(tx_fifo_rp_1)
INPUT(keyinput7)
INPUT(tx_fifo_gb)
INPUT(sio_ce)
INPUT(txf_empty_r)
INPUT(rst)
OUTPUT(txf_empty_r_Q)
txf_empty_r_Q = NAND(n1145,rst)
n1145 = OR(n1144,n1143)
n1144 = NOR(n1142,n1141)
n1142 = NOR(n1139,tx_fifo_gb)
n1139 = NOR(n1155,keyinput7)
n1155 = NOR(n1137,n1138)
n1137 = XOR(tx_fifo_rp_0,tx_fifo_wp_0)
n1138 = XOR(n1321,tx_fifo_rp_1)
n1321 = NOT(n1326)
n1326 = NOT(tx_fifo_wp_1)
n1141 = NAND(n1140,sio_ce)
n1140 = NAND(n1155,keyinput7)
n1143 = NOR(txf_empty_r,sio_ce)
